# 複製成 .env 後填入自己的值。.env 已被 .gitignore 擋住，不會進版本控制。
#
# POSTGRES_PASSWORD 請自己產一組，不要沿用任何範例值：
#   openssl rand -base64 24
# docker compose 第一次啟動時，會用這組帳密初始化資料庫。

POSTGRES_USER=請填入資料庫使用者
POSTGRES_PASSWORD=請填入自己產生的強密碼
POSTGRES_DB=market_intelligence

# 這裡的 db 是 docker-compose.yml 裡的服務名稱，容器之間靠它互相解析，
# 不是主機名稱。在 compose 之外執行時才需要改成實際位址。
POSTGRES_HOST=db
POSTGRES_PORT=5432

PORT=3000

# 密碼要和上面的 POSTGRES_PASSWORD 一致。
DATABASE_URL=postgres://請填入資料庫使用者:請填入自己產生的強密碼@db:5432/market_intelligence

# 各爬蟲的抓取間隔（秒）
STOCK_FETCH_INTERVAL=3600
HOUSING_FETCH_INTERVAL=86400
SENTIMENT_FETCH_INTERVAL=21600
